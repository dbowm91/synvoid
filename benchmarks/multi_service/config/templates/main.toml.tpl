# Generated by benchmarks/multi_service/driver.py — do not commit this file.
# Placeholders are substituted from the run manifest. No secret is written.
# This is a local, loopback-only benchmark profile, not a production config.

[server]
host = "127.0.0.1"
port = @@HTTP_PORT@@
trusted_proxies = ["127.0.0.1", "::1"]

[tokio]
worker_threads = @@WORKER_THREADS@@

[process_manager]
worker_threads = @@WORKER_THREADS@@

[fallback]
mode = "return_404"

[admin]
enabled = true
port = @@ADMIN_PORT@@
bind_address = "127.0.0.1"
token_env_var = "SYNVOID_ADMIN_TOKEN"
secure_cookie = false
bcrypt_cost = 12

[logging]
level = "warn"
access_log = false

[metrics]
enabled = true
port = @@METRICS_PORT@@
bind_address = "127.0.0.1"

[security]
ipc_enforce_signing = true
ipc_session_key_env = "SYNVOID_IPC_KEY"

[ip_feeds]
enabled = false

[threat_level]
initial = 1
auto_scale = false

[threat_level.escalation]
enabled = false
excluded_ips = ["127.0.0.1", "::1"]

[http]
max_request_size = 16777216
max_streaming_body_size = 16777216
max_connections = 100000
keep_alive_timeout_secs = 120
header_read_timeout_secs = 30
@@HTTP_LISTENER_SECTION@@

[traffic_shaping]
enabled = false

@@TLS_SECTION@@
@@HTTP3_SECTION@@

[defaults.ratelimit]
mode = "isolated"

[defaults.ratelimit.ip]
per_second = 1000000
per_minute = 100000000
per_5min = 100000000
per_10min = 100000000
per_hour = 100000000
per_day = 100000000
burst = 1000000

[defaults.ratelimit.global]
per_second = 1000000
per_minute = 100000000
per_5min = 100000000
max_connections = 100000

[defaults.worker_pool]
mode = "shared"
workers = @@WORKERS@@
allow_multi_worker = @@ALLOW_MULTI_WORKER@@

[defaults.honeypot]
enabled = false

[defaults.honeypot_probe]
enabled = false

[defaults.suspicious_words]
enabled = false

[defaults.upstream_errors]
enabled = false

[defaults.persistence]
enabled = false
data_dir = "@@DATA_DIR@@"

[defaults.tarpit]
enabled = false

[defaults.bot]
block_ai_crawlers = false
enable_css_honeypot = false
scraper_patterns = []

[tcp]
enabled = @@TCP_ENABLED@@
worker_pool_size = 2

[tcp.protocols.echo]
ports = [@@TCP_SINGLE_PORT@@]
upstream_format = "127.0.0.1:@@TCP_UPSTREAM_PORT@@"
# Echo is a custom protocol the detector does not recognize; keep the
# detector out of the path so the harness measures the proxy, not a stall.
filter_enabled = false

[tcp.protocols.echo_multi]
ports = [@@TCP_MULTI_PORTS@@]
upstream_format = "127.0.0.1:@@TCP_UPSTREAM_PORT@@"
filter_enabled = false

[udp]
enabled = @@UDP_ENABLED@@
worker_pool_size = 2

[udp.protocols.echo]
ports = [@@UDP_SINGLE_PORT@@]
upstream_format = "127.0.0.1:@@UDP_UPSTREAM_PORT@@"
filter_enabled = false

[udp.protocols.echo_multi]
ports = [@@UDP_MULTI_PORTS@@]
upstream_format = "127.0.0.1:@@UDP_UPSTREAM_PORT@@"
filter_enabled = false
