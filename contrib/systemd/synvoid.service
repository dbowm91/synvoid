[Unit]
Description=SynVoid - Multi-Process Web Application Firewall
Documentation=https://github.com/dbowm91/synvoid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synvoid
Group=synvoid
UMask=0077
WorkingDirectory=/opt/synvoid

# Plain `--foreground` runs the Supervisor: it spawns and supervises the
# UnifiedServerWorker data-plane processes and the CPU offload worker.
# There is deliberately no `--overseer` flag — it was never defined in
# `synvoid-cli` and clap rejected it, so the unit exited 2 before reading any
# configuration. See architecture/quickstart_verification_findings.md (F-4).
ExecStart=/usr/local/bin/synvoid --foreground --config-path /etc/synvoid

# `--config-path` takes the DIRECTORY that contains `main.toml` and `sites/`,
# not the TOML file itself.
#
# Reload is IPC-driven, not signal-driven: `--rehash` locates the Supervisor
# through its pidfile and sends `SupervisorCommand::ReloadConfig`. SynVoid has
# no inbound SIGHUP handler — SIGHUP only ever appears as an *outbound* signal
# inside `synvoid-ipc` — so `kill -HUP $MAINPID` was a silent no-op.
ExecReload=/usr/local/bin/synvoid --rehash

Restart=always
RestartSec=5s

# Resource limits
LimitNOFILE=65535
LimitNPROC=65535

# --- Least privilege ---------------------------------------------------------
# The service runs as the dedicated `synvoid` account. Binding 80/443 is the
# only privileged operation and is granted with an ambient capability; the WAF
# needs no other root capability. `CAP_NET_ADMIN` is NOT granted by default;
# opt-in eBPF/ICMP/WireGuard deployments must add it in a drop-in (see
# docs/DEPLOYMENT.md and docs/SECURITY.md).
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# --- Filesystem and kernel hardening ----------------------------------------
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

# `MemoryDenyWriteExecute` is deliberately NOT set: Wasmtime's JIT and the
# dynamic plugin path need executable mappings. Deployments that disable both
# may add it as a documented opt-in drop-in.

# The install tree (/opt/synvoid) is read-only. State, logs, cache and runtime
# data live in the directories below; systemd creates them with the right
# ownership and they are the only writable paths besides /etc/synvoid.
StateDirectory=synvoid
StateDirectoryMode=0700
LogsDirectory=synvoid
LogsDirectoryMode=0750
CacheDirectory=synvoid
CacheDirectoryMode=0700
RuntimeDirectory=synvoid
RuntimeDirectoryMode=0700
ReadWritePaths=/etc/synvoid /var/lib/synvoid /var/log/synvoid /var/cache/synvoid /run/synvoid

# /etc/synvoid is writable so the admin config editor can save `main.toml` and
# `sites/`. The install tree stays read-only; if the admin editor is not used,
# make /etc/synvoid root-owned and read-only and remove it from ReadWritePaths.

# Environment
# Optional operator secrets (for example SYNVOID_ADMIN_TOKEN). The leading `-`
# makes a missing file non-fatal.
EnvironmentFile=-/etc/synvoid/secrets.env
Environment=RUST_LOG=info
Environment=SYNVOID_ADMIN_UI_DIR=/opt/synvoid/admin-ui/dist

# `PidFileManager::new()` resolves its data directory via `dirs::data_dir()`,
# which on Linux is `$XDG_DATA_HOME`. Left unset it resolves under `$HOME`, and
# `ProtectHome=true` makes that path unreachable for the service user — the
# pidfile and IPC socket could not be created, which breaks `--status`,
# `--stop` and `--rehash`. There is no `SYNVOID_DATA_DIR` override, so XDG is
# the only lever. StateDirectory= creates the target directory.
Environment=XDG_DATA_HOME=/var/lib/synvoid

# NOTE: no `WatchdogSec`. SynVoid never calls `sd_notify(3)` — the `sd-notify`
# dependency was removed (see plans/root_dependency_ownership.md) — so
# `WatchdogSec=30s` made systemd consider the service hung, kill it every 30
# seconds, and (with Restart=always) turn that into a restart loop.

[Install]
WantedBy=multi-user.target
